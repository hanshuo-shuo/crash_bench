{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crashbench.local/schemas/mechanism.schema.json",
  "title": "CrashBench mechanism specification",
  "type": "object",
  "required": ["mechanism_id", "version", "task_ids", "conditions", "hazard_condition", "matched_control_conditions", "severity_ids", "deployable_option_ids", "diagnostic_option_ids", "information_contract_version"],
  "properties": {
    "mechanism_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "conditions": {"type": "array", "minItems": 2, "uniqueItems": true},
    "severity_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "deployable_option_ids": {"type": "array", "minItems": 2, "uniqueItems": true}
  }
}
