{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crashbench.local/schemas/gate_decision.schema.json",
  "title": "CrashBench machine gate decision",
  "type": "object",
  "required": ["schema_version", "kind", "stage_id", "criteria", "status", "next_action", "non_compensatory", "decision_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "crashbench_machine_gate_decision"},
    "status": {"enum": ["GO", "NO_GO", "SCOPED_CONTINUE", "INCONCLUSIVE_FAIL_CLOSED"]},
    "non_compensatory": {"const": true},
    "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "criterion_class", "actual", "operator", "threshold", "evidence_state", "pass"]
      }
    }
  }
}
